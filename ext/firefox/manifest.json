{
  "manifest_version": 3,
  "name": "SwiftDM Browser Integration",
  "version": "0.7.2",
  "description": "Send links, pages, POST downloads, custom headers and the video playing in the browser to SwiftDM.",
  "browser_specific_settings": {
    "gecko": {
      "id": "swiftdm@swift-download-manager",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": ["activeTab", "contextMenus", "downloads", "scripting", "storage", "webRequest"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["http://127.0.0.1:10007/*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media-detect.js", "media-mse.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "api.js",
      "cookie-permission.js",
      "action-icon.js",
      "media-detect.js",
      "media-mse.js",
      "core.js"
    ]
  },
  "action": {
    "default_title": "SwiftDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:10007"
  }
}
