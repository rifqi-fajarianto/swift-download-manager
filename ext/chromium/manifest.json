{
  "manifest_version": 3,
  "key": "",
  "name": "SwiftDM Browser Integration",
  "version": "0.3.0",
  "description": "Send links, pages, POST downloads and custom headers from Chromium browsers to SwiftDM.",
  "permissions": ["activeTab", "contextMenus", "downloads", "storage", "webRequest"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["http://127.0.0.1:10007/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "SwiftDM",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:10007"
  }
}
